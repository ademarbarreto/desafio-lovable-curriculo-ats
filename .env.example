# Currículo Certeiro — variáveis de ambiente
# ============================================
# Este arquivo documenta as variáveis usadas pelo projeto.
# Copie para `.env` localmente e preencha os valores (ou aguarde o Lovable
# regenerar o `.env` automaticamente — ele é gerado pela plataforma).
#
# IMPORTANTE: estes valores são PUBLISHABLE (chaves públicas de leitura).
# Segredos reais (chaves de serviço, tokens de IA) NÃO ficam no `.env` —
# são armazenados no cofre de segredos do Lovable (add_secret) e injetados
# no backend em tempo de execução.

# URL do projeto backend (Lovable Cloud / Supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Variantes sem prefixo VITE_ (usadas em tooling/scripts)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=